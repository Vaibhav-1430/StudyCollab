NODE_ENV=development
APP_NAME=study-collab-platform
PORT=4000
CLIENT_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
TRUST_PROXY=0

MONGO_URI=mongodb://127.0.0.1:27017/study-collab
MONGO_CONNECT_RETRIES=5
MONGO_RETRY_DELAY_MS=1500
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_POOL_SIZE=10
MONGO_AUTO_INDEX=true

JWT_SECRET=development-only-study-collab-secret-change-before-production
JWT_EXPIRES_IN=7d

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
MAX_FILE_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/markdown

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=study-collab

STUN_URLS=stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

SOCKET_PING_TIMEOUT_MS=20000
SOCKET_PING_INTERVAL_MS=25000
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
LOG_LEVEL=debug
